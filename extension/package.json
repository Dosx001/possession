{
  "name": "extension",
  "private": true,
  "scripts": {
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "package": "pnpm -r package",
    "bundle": "pnpm clean && pnpm build && pnpm package"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-plugin-solid": "^0.17.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
