{
  "name": "extension",
  "private": true,
  "scripts": {
    "lint": "pnpm -r lint",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "package": "pnpm -r package",
    "bundle": "pnpm clean && pnpm build && pnpm package"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.3.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-solid": "^0.17.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
