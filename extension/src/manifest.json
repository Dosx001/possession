{
  "manifest_version": 2,
  "permissions": [
    "<all_urls>",
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@possession"
    }
  },
  "browser_action": {
    "browser_style": true,
    "default_popup": "src/popup/index.html",
    "default_title": "possession",
    "default_icon": {
      "32": "32.png",
      "48": "48.png",
      "64": "64.png",
      "128": "128.png"
    }
  },
  "options_ui": {
    "browser_style": true,
    "open_in_tab": true,
    "page": "src/popup/index.html"
  },
  "background": {
    "scripts": [
      "src/background.ts"
    ]
  },
  "icons": {
    "32": "32.png",
    "48": "48.png",
    "64": "64.png",
    "128": "128.png"
  }
}
