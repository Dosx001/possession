{
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@possession"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "possession",
    "default_icon": {
      "32": "logo.svg",
      "48": "logo.svg",
      "64": "logo.svg",
      "128": "logo.svg"
    }
  },
  "options_ui": {
    "browser_style": true,
    "open_in_tab": true,
    "page": "src/popup/index.html"
  },
  "background": {
    "scripts": [
      "src/background.ts"
    ]
  },
  "icons": {
    "32": "logo.svg",
    "48": "logo.svg",
    "64": "logo.svg",
    "128": "logo.svg"
  }
}
