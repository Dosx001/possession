{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "module": "preserve",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "baseUrl": "src"
  },
  "references": [
    {
      "path": "tsconfig.node.json"
    }
  ]
}
